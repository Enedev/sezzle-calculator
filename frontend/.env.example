# Base URL the typed API client (src/api/client.ts) prepends to every
# request. Leave unset for local dev and for the production Docker image —
# both cases serve the frontend and the API from the same origin, so the
# default relative "/api/v1" already resolves correctly.
# Only set this if the frontend is deployed on a different origin than the API.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Where the Vite dev server proxies /api/* requests to. Only read by
# vite.config.ts (not by the browser bundle), so it has no VITE_ prefix.
# Defaults to http://localhost:8080, matching the Go server's default PORT.
# BACKEND_PROXY_TARGET=http://localhost:8080
